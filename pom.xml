<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.tcc</groupId>
    <artifactId>auditoria-ibs-cbs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>auditoria-ibs-cbs</name>
    <description>Auditoria de coerencia dos campos de IBS/CBS em documentos fiscais eletronicos</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jaxb2-maven-plugin.version>3.2.0</jaxb2-maven-plugin.version>

        <!--
            Testcontainers acima do que o parent do Spring Boot 3.3 gerencia
            (1.19.8). A versao gerenciada negocia a API 1.32 do Docker, e o
            Docker Engine 29 exige no minimo 1.40: a conexao morre com
            "400 Bad Request" sem mensagem, e o teste de integracao se desabilita
            achando que nao ha Docker. Esta propriedade e a que o
            spring-boot-dependencies usa para o testcontainers-bom.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>

        <!--
            Apache POI, para o papel de trabalho em xlsx. Nao e gerenciado pelo
            parent do Spring Boot, entao a versao vem daqui.
        -->
        <poi.version>5.5.1</poi.version>
        <pacote.das.classes.geradas>br.edu.tcc.auditoria.infraestrutura.xml.gerado</pacote.das.classes.geradas>
    </properties>

    <!--
        Nenhuma dependencia de web nesta etapa: a interface de uso e uma CLI
        (D006). Nao ha spring-boot-starter-web nem spring-boot-starter-webflux,
        e nao deve haver enquanto nao existir decisao registrada em contrario.

        As versoes de todas as dependencias vem do dependencyManagement do
        parent do Spring Boot, inclusive as de Testcontainers.
    -->
    <dependencies>
        <!--
            JAXB. Usado somente por infraestrutura/xml e pelas classes geradas a
            partir do XSD oficial. O pacote dominio nao pode importar nada disto
            (D001), e ha teste que verifica isso.
        -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!--
            Spring Boot sem web. O contexto sobe, roda o comando pedido na linha
            de comando e encerra.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Persistencia. As entidades JPA ficam apenas em
            infraestrutura/persistencia: o dominio nao tem anotacao nenhuma
            (D001), e o mapeamento entre os dois e explicito (D006).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway e o unico dono do esquema. O Hibernate roda com
            ddl-auto=validate e nao cria nem altera tabela.

            flyway-database-postgresql e obrigatorio a partir do Flyway 10: o
            suporte a cada banco saiu do core para um modulo proprio.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Escrita do papel de trabalho em xlsx. Usado somente por
            infraestrutura/exportacao: o formato do arquivo e detalhe de saida, e
            nem o dominio nem a aplicacao conhecem POI.

            O log4j-api que o POI traz e redirecionado para o SLF4J pelo
            log4j-to-slf4j que o spring-boot-starter-logging ja inclui.
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Testcontainers: o teste de integracao roda contra um PostgreSQL de
            verdade, com as migrations do Flyway aplicadas. Banco em memoria nao
            serviria — o esquema usa tipos e restricoes de PostgreSQL, e o que
            precisa ser provado e justamente que reprocessar o mesmo lote nao
            duplica achado no banco real.

            Exige Docker em execucao. Sem Docker, o teste se desabilita em vez
            de falhar (ver PersistenciaDeAuditoriaIT).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Empacotamento executavel para a CLI:
                java -jar target/auditoria-ibs-cbs-<versao>.jar <comando> ...
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Geracao das classes de leiaute a partir dos XSD oficiais do
                Portal Nacional da NF-e.

                Os XSD NAO estao no repositorio: quem clona o projeto precisa
                baixa-los e coloca-los em src/main/resources/schemas. A lista
                exata dos arquivos esta em src/main/resources/schemas/LEIAME.md.
                Sem eles, este plugin nao gera nada e a compilacao falha
                apontando o pacote inexistente.

                Somente os dois esquemas raiz sao listados como fonte. Os demais
                entram por xs:include a partir deles; lista-los tambem faria o
                XJC compilar o mesmo esquema duas vezes e falhar com colisao de
                nomes na ObjectFactory.

                As classes geradas ficam num pacote separado e sao tratadas como
                detalhe de infraestrutura: so infraestrutura/xml as enxerga.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>${jaxb2-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>gerar-classes-do-leiaute-nfe</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sources>
                        <source>src/main/resources/schemas/procNFe_v4.00.xsd</source>
                        <source>src/main/resources/schemas/nfe_v4.00.xsd</source>
                    </sources>
                    <packageName>${pacote.das.classes.geradas}</packageName>
                    <outputDirectory>${project.build.directory}/generated-sources/jaxb</outputDirectory>
                    <clearOutputDir>false</clearOutputDir>
                    <locale>pt_BR</locale>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
